{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editagent.local/schemas/project-v1_1.schema.json",
  "title": "Project document 1.1.0 with source-bound captions",
  "description": "Portable Project plus Timeline. Cross-reference, overlap and temporal invariants are additionally enforced by domain construction.",
  "$defs": {
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "clipId", "kind", "value"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "clipId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": ["opacity", "gain"]
        },
        "value": {
          "type": "number",
          "minimum": -60,
          "maximum": 12
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "opacity"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromClipId", "toClipId", "kind", "durationUs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "fromClipId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "toClipId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": ["cut", "dissolve"]
        },
        "durationUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cut"
              }
            }
          },
          "then": {
            "properties": {
              "durationUs": {
                "const": "0"
              }
            }
          },
          "else": {
            "properties": {
              "durationUs": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          }
        }
      ]
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "trackId",
        "kind",
        "inPoint",
        "outPoint",
        "timelineStartUs",
        "sourceId",
        "text",
        "componentId",
        "opacity",
        "volumeDb",
        "effects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "trackId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": ["video", "overlay", "graphics", "caption", "audio"]
        },
        "inPoint": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "outPoint": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "timelineStartUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "sourceId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "componentId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "volumeDb": {
          "type": "number",
          "minimum": -60,
          "maximum": 12
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "caption"
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              },
              "sourceId": {
                "type": "null"
              },
              "componentId": {
                "type": "null"
              },
              "inPoint": {
                "const": "0"
              }
            }
          },
          "else": {
            "properties": {
              "text": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "graphics"
              }
            }
          },
          "then": {
            "properties": {
              "componentId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "sourceId": {
                "type": "null"
              },
              "inPoint": {
                "const": "0"
              }
            }
          },
          "else": {
            "properties": {
              "componentId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["video", "overlay", "audio"]
              }
            }
          },
          "then": {
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timelineId", "kind", "clips", "transitions"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "timelineId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": ["video", "overlay", "graphics", "caption", "audio"]
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clip"
          }
        },
        "transitions": {
          "description": "Structural validation only; Track construction enforces at most one transition per ordered fromClipId/toClipId join.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "durationUs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": ["video", "audio", "image"]
        },
        "durationUs": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "frameRate", "durationUs"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "frameRate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "denominator": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "durationUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "createdAt",
        "composition",
        "sources",
        "tracks",
        "captionsV1"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "createdAt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "composition": {
          "$ref": "#/$defs/composition"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "captionsV1": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "1.0.0"
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "createdBy": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "assetId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "sourceSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "sourceDurationUs": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,9})$(?![\\s\\S])",
                "maxLength": 10
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": ["media-analysis", "human-timed"],
                    "type": "string"
                  },
                  "documentSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "minLength": 64,
                    "maxLength": 64
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$(?![\\s\\S])",
                    "maxLength": 32
                  }
                },
                "required": ["kind", "documentSha256", "version"]
              },
              "style": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "type": "string",
                    "pattern": "^#[a-f0-9]{6}$",
                    "minLength": 7,
                    "maxLength": 7
                  },
                  "background": {
                    "type": "string",
                    "pattern": "^#[a-f0-9]{6}$",
                    "minLength": 7,
                    "maxLength": 7
                  },
                  "highlight": {
                    "type": "string",
                    "pattern": "^#[a-f0-9]{6}$",
                    "minLength": 7,
                    "maxLength": 7
                  },
                  "outline": {
                    "type": "string",
                    "pattern": "^#[a-f0-9]{6}$",
                    "minLength": 7,
                    "maxLength": 7
                  },
                  "outlinePx": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "shadowPx": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "font": {
                    "const": "DejaVu Sans",
                    "type": "string"
                  },
                  "fontSize": {
                    "type": "integer",
                    "minimum": 8,
                    "maximum": 96
                  },
                  "direction": {
                    "enum": ["auto", "ltr", "rtl"],
                    "type": "string"
                  },
                  "preset": {
                    "enum": ["vertical", "square", "landscape"],
                    "type": "string"
                  },
                  "marginPermille": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "color",
                  "background",
                  "highlight",
                  "outline",
                  "outlinePx",
                  "shadowPx",
                  "font",
                  "fontSize",
                  "direction",
                  "preset",
                  "marginPermille"
                ]
              },
              "rules": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "maxCharacters": {
                    "type": "integer",
                    "minimum": 8,
                    "maximum": 42
                  },
                  "maxLines": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                  },
                  "maxCharactersPerSecond": {
                    "type": "integer",
                    "minimum": 8,
                    "maximum": 30
                  },
                  "minDurationUs": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,9})$(?![\\s\\S])",
                    "maxLength": 10
                  }
                },
                "required": ["maxCharacters", "maxLines", "maxCharactersPerSecond", "minDurationUs"]
              },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "startUs": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,9})$(?![\\s\\S])",
                      "maxLength": 10
                    },
                    "endUs": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,9})$(?![\\s\\S])",
                      "maxLength": 10
                    },
                    "lines": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 2,
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 42,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "startUs": {
                              "type": "string",
                              "pattern": "^(0|[1-9][0-9]{0,9})$(?![\\s\\S])",
                              "maxLength": 10
                            },
                            "endUs": {
                              "type": "string",
                              "pattern": "^(0|[1-9][0-9]{0,9})$(?![\\s\\S])",
                              "maxLength": 10
                            },
                            "confidence": {
                              "anyOf": [
                                {
                                  "type": "null"
                                },
                                {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1
                                }
                              ]
                            }
                          },
                          "required": ["text", "startUs", "endUs", "confidence"]
                        }
                      }
                    }
                  },
                  "required": ["startUs", "endUs", "lines"]
                }
              }
            },
            "required": [
              "schemaVersion",
              "id",
              "createdBy",
              "assetId",
              "sourceSha256",
              "sourceDurationUs",
              "evidence",
              "style",
              "rules",
              "blocks"
            ]
          }
        }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "role", "createdAt"],
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "role": {
          "enum": ["owner", "editor", "viewer"]
        },
        "createdAt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "memberships", "createdAt", "updatedAt", "deletedAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "memberships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/membership"
          },
          "minItems": 1
        },
        "createdAt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "deletedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "timeline"],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    }
  }
}
