{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editagent.local/schemas/edit-command.schema.json",
  "title": "Edit command, log and history v1",
  "description": "Pure data. The domain additionally validates references, ranges, inverse preconditions and history cursor bounds.",
  "$defs": {
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "id", "timelineId", "type", "payload"],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "timelineId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "type": {
              "const": "TrimClip"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clipId", "startUs", "endUs"],
              "properties": {
                "clipId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "startUs": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "endUs": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "id", "timelineId", "type", "payload"],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "timelineId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "type": {
              "const": "SplitClip"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clipId", "atUs", "rightClipId", "rightEffectIds"],
              "properties": {
                "clipId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "atUs": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "rightClipId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "rightEffectIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "id", "timelineId", "type", "payload"],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "timelineId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "type": {
              "const": "MoveClip"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clipId", "trackId", "startUs"],
              "properties": {
                "clipId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "trackId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "startUs": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "id", "timelineId", "type", "payload"],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "timelineId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "type": {
              "const": "DeleteRange"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["startUs", "endUs", "fragments"],
              "properties": {
                "startUs": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "endUs": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "fragments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["clipId", "rightClipId", "rightEffectIds"],
                    "properties": {
                      "clipId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      "rightClipId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      "rightEffectIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "id", "timelineId", "type", "payload"],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "timelineId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "type": {
              "const": "InsertClip"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clip"],
              "properties": {
                "clip": {
                  "$ref": "https://editagent.local/schemas/project.schema.json#/$defs/clip"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "id", "timelineId", "type", "payload"],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "timelineId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "type": {
              "const": "SetProperty"
            },
            "payload": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["clipId", "key", "value"],
                  "properties": {
                    "clipId": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    "key": {
                      "const": "opacity"
                    },
                    "value": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["clipId", "key", "value"],
                  "properties": {
                    "clipId": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    "key": {
                      "const": "volumeDb"
                    },
                    "value": {
                      "type": "number",
                      "minimum": -60,
                      "maximum": 12
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["clipId", "key", "value"],
                  "properties": {
                    "clipId": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    "key": {
                      "const": "text"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "id", "timelineId", "type", "payload"],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "timelineId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "type": {
              "const": "AddCaption"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["captionId", "trackId", "startUs", "endUs", "text"],
              "properties": {
                "captionId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "trackId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "startUs": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "endUs": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                }
              }
            }
          }
        }
      ]
    },
    "inverse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "expected", "restore"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "RestoreTimeline"
        },
        "expected": {
          "$ref": "https://editagent.local/schemas/project.schema.json#/$defs/timeline"
        },
        "restore": {
          "$ref": "https://editagent.local/schemas/project.schema.json#/$defs/timeline"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "inverse"],
      "properties": {
        "command": {
          "$ref": "#/$defs/command"
        },
        "inverse": {
          "$ref": "#/$defs/inverse"
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "timelineId", "commands"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "timelineId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          },
          "maxItems": 1000
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "snapshot", "entries", "cursor", "maxEntries"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "snapshot": {
          "$ref": "https://editagent.local/schemas/project.schema.json#/$defs/timeline"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "maxItems": 1000
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "maxEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/log"
    },
    {
      "$ref": "#/$defs/history"
    }
  ]
}
