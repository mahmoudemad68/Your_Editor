{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist-test",
    "rootDir": "src",
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"],
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/presentation/**/*.ts",
    "src/presentation/**/*.tsx",
    "src/infrastructure/**/*.ts",
    "src/generated/**/*.ts",
    "src/project-contract.ts",
    "src/composition/project-response.ts",
    "src/composition/project-response.test.ts",
    "src/composition/auth-proxy.ts",
    "src/composition/auth-proxy.test.ts",
    "src/composition/api-readiness.test.ts",
    "src/composition/project-actions.test.ts",
    "src/composition/job-proxy.ts",
    "src/composition/job-proxy.test.ts",
    "src/job-contract.ts"
  ],
  "exclude": [
    "node_modules",
    "src/presentation/upload-hash.ts",
    "src/presentation/sha256.worker.ts"
  ]
}
