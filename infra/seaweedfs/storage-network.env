# Fixed addresses for the SeaweedFS storage network.
# compose.yaml, certificate SANs, the volume whitelist, and host isolation
# all use these values. Changing one file without the others breaks mTLS or
# the volume whitelist.
SEAWEED_SUBNET=172.30.210.0/24
SEAWEED_GATEWAY_IP=172.30.210.1
SEAWEED_MASTER_IP=172.30.210.10
SEAWEED_VOLUME_IP=172.30.210.11
SEAWEED_FILER_IP=172.30.210.12
SEAWEED_S3_IP=172.30.210.13
