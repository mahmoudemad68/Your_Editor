          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "immutableIndependentABTracks": {
          "const": true
        },
        "preAdjudicationIaaRequired": {
          "const": true
        },
        "separateIndependentAdjudicatorRequired": {
          "const": true
        },
        "audioBasedRationaleRequired": {
          "const": true
        },
        "blockingDimensions": {
          "type": "array",
          "items": {
            "enum": [
              "EVENT_CLASS",
              "WORD_MAPPING",
              "BOUNDARY",
              "PROTECTION",
              "DENOMINATOR",
              "POPULATION",
              "PASS_FAIL"
            ]
          },
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true
        },
        "anyAffectedUnresolvedBlocksQualification": {
          "const": true
        },
        "blockEvenIfPointScoreAndBoundsPass": {
          "const": true
        },
        "uncertaintyBoundsRole": {
          "const": "REPORT_ONLY_NEVER_UNBLOCK"
        },
        "unknownDisposition": {
          "const": "BLOCKED_QUALIFICATION"
        },
        "insufficientCoverageDisposition": {
          "const": "NOT_QUALIFIED"
        },
        "reviewTriggersAreAcceptanceCollars": {
          "const": false
        },
        "silentClipOrPredictionExclusionAllowed": {
          "const": false
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://your-editor.local/reference-review/protocol/1.0.0-draft.2.schema.json",
  "title": "Reference qualification protocol review snapshot 1.0.0-draft.2",
  "description": "Strict review-document schema only; not a human annotation schema, acceptance decision or production policy.",
  "$defs": {
    "ArabicScopeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha256",
        "speakerRef",
        "variety",
        "otherSpecified",
        "varietyEvidenceRef",
        "competenceEvidenceRef",
        "independentlyAnnotated",
        "coverage",
        "qualificationClaim"
      ],
      "properties": {
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "speakerRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "variety": {
          "enum": ["EGYPTIAN_ARABIC", "MSA", "OTHER_SPECIFIED", "UNKNOWN"]
        },
        "otherSpecified": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          ]
        },
        "varietyEvidenceRef": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          ]
        },
        "competenceEvidenceRef": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          ]
        },
        "independentlyAnnotated": {
          "type": "boolean"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceGroups",
            "speakers",
            "clips",
            "positiveFiller",
            "positiveRepetition",
            "negativeFiller",
            "negativeRepetition",
            "declaredConditionsCovered"
          ],
          "properties": {
            "sourceGroups": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "speakers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "clips": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "positiveFiller": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "positiveRepetition": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "negativeFiller": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "negativeRepetition": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "declaredConditionsCovered": {
              "type": "boolean"
            }
          }
        },
        "qualificationClaim": {
          "enum": ["NOT_QUALIFIED", "NOT_PROVEN", "QUALIFIED_SCOPE"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "variety": {
                "const": "OTHER_SPECIFIED"
              }
            },
            "required": ["variety"]
          },
          "then": {
            "properties": {
              "otherSpecified": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          },
          "else": {
            "properties": {
              "otherSpecified": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "variety": {
                "const": "UNKNOWN"
              }
            },
            "required": ["variety"]
          },
          "then": {
            "properties": {
              "qualificationClaim": {
                "const": "NOT_QUALIFIED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "qualificationClaim": {
                "const": "QUALIFIED_SCOPE"
              }
            },
            "required": ["qualificationClaim"]
          },
          "then": {
            "properties": {
              "variety": {
                "enum": ["EGYPTIAN_ARABIC", "MSA", "OTHER_SPECIFIED"]
              },
              "varietyEvidenceRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "competenceEvidenceRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "independentlyAnnotated": {
                "const": true
              },
              "coverage": {
                "type": "object",
                "properties": {
                  "sourceGroups": {
                    "type": "integer",
                    "minimum": 3
                  },
                  "speakers": {
                    "type": "integer",
                    "minimum": 3
                  },
                  "clips": {
                    "type": "integer",
                    "minimum": 3
                  },
                  "positiveFiller": {
                    "type": "integer",
                    "minimum": 10
                  },
                  "positiveRepetition": {
                    "type": "integer",
                    "minimum": 10
                  },
                  "negativeFiller": {
                    "type": "integer",
                    "minimum": 10
                  },
                  "negativeRepetition": {
                    "type": "integer",
                    "minimum": 10
                  },
                  "declaredConditionsCovered": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    },
    "AdjudicationOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolutionStatus",
        "affectedDimensions",
        "independentAdjudicator",
        "audioBasedRationale",
        "strictPrecision",
        "qualificationDisposition"
      ],
      "properties": {
        "resolutionStatus": {
          "enum": ["RESOLVED", "UNKNOWN_UNRESOLVED", "INSUFFICIENT_COVERAGE"]
        },
        "affectedDimensions": {
          "type": "array",
          "items": {
            "enum": [
              "EVENT_CLASS",
              "WORD_MAPPING",
              "BOUNDARY",
              "PROTECTION",
              "DENOMINATOR",
              "POPULATION",
              "PASS_FAIL"
            ]
          },
          "minItems": 0,
          "maxItems": 7,
          "uniqueItems": true
        },
        "independentAdjudicator": {
          "const": true
        },
        "audioBasedRationale": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          ]
        },
        "strictPrecision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        },
        "qualificationDisposition": {
          "enum": ["ELIGIBLE_FOR_SCORING", "BLOCKED_QUALIFICATION", "NOT_QUALIFIED"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolutionStatus": {
                "const": "RESOLVED"
              }
            },
            "required": ["resolutionStatus"]
          },
          "then": {
            "properties": {
              "qualificationDisposition": {
                "const": "ELIGIBLE_FOR_SCORING"
              },
              "audioBasedRationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resolutionStatus": {
                "const": "UNKNOWN_UNRESOLVED"
              }
            },
            "required": ["resolutionStatus"]
          },
          "then": {
            "properties": {
              "qualificationDisposition": {
                "const": "BLOCKED_QUALIFICATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resolutionStatus": {
                "const": "INSUFFICIENT_COVERAGE"
              }
            },
            "required": ["resolutionStatus"]
          },
          "then": {
            "properties": {
              "qualificationDisposition": {
                "const": "NOT_QUALIFIED"
              }
            }
          }
        }
      ]
    }
  }
