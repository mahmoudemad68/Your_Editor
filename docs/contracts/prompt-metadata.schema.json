{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://your-editor.local/contracts/prompt-metadata/1.0.0",
  "title": "Prompt metadata 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "purpose", "variables"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"
    },
    "purpose": { "type": "string", "pattern": "^[a-zA-Z0-9 .,()-]{1,240}$" },
    "variables": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "allOf": [
          { "pattern": "^[a-z][a-z0-9_-]{0,47}$" },
          { "not": { "enum": ["constructor", "prototype", "__proto__"] } }
        ]
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "required", "trust"],
            "properties": {
              "type": { "const": "string" },
              "required": { "type": "boolean" },
              "trust": { "const": "data" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "required", "trust", "values"],
            "properties": {
              "type": { "const": "string" },
              "required": { "type": "boolean" },
              "trust": { "const": "enum" },
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$" }
              }
            }
          }
        ]
      }
    }
  }
}
