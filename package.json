{
  "name": "editagent",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "build": "pnpm schemas:check && turbo run build",
    "test": "turbo run test && pnpm --filter @editagent/web check:api-client && node tools/test/run-node-tests.mjs tests/architecture/*.test.mjs tests/integration/*.test.mjs && node tools/test/require-coverage.mjs && pnpm --filter @editagent/web test:e2e",
    "lint": "node tools/architecture/ffmpeg-boundary.mjs && eslint . --max-warnings=0 && prettier --check . && depcruise --config .dependency-cruiser.cjs apps packages workers && turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "architecture": "node tools/architecture/ffmpeg-boundary.mjs && depcruise --config .dependency-cruiser.cjs apps packages workers && turbo run lint --filter=@editagent/ai-worker",
    "check": "python3 tools/roadmap/build_roadmap.py --check && pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky",
    "test:unit": "pnpm --filter @editagent/domain test",
    "test:coverage": "pnpm --filter @editagent/domain test",
    "test:integration": "node --test tests/integration/testcontainers.test.mjs",
    "test:fixtures": "node --test tests/integration/media-fixtures.test.mjs",
    "test:e2e": "pnpm --filter @editagent/web test:e2e",
    "test:walking-skeleton": "node tools/test/run-walking-skeleton.mjs",
    "test:services": "node tools/test/with-services.mjs",
    "evaluation:validate": "node tools/evaluation/validate.mjs",
    "evaluation:test": "node --test tests/integration/evaluation.test.mjs",
    "evaluation:docs": "node tools/evaluation/docs.mjs",
    "evaluation:sync": "node tools/evaluation/storage.mjs sync",
    "evaluation:deep": "node tools/evaluation/storage.mjs deep",
    "evaluation:render": "node tools/evaluation/references.mjs render",
    "evaluation:review": "node tools/evaluation/references.mjs review",
    "evaluation:version": "node tools/evaluation/version.mjs",
    "evaluation:annotation-clip": "node tools/evaluation/annotation-clip.mjs",
    "evaluation:certify": "node tools/evaluation/storage.mjs certify",
    "evaluation:import-generated": "node tools/evaluation/annotations.mjs",
    "evaluation:archive-evidence": "node tools/evaluation/evidence.mjs",
    "vad:evaluate": "node tools/vad/evaluate.mjs",
    "vad:setup": "uv run --project workers/ai-worker python -m editagent_ai_worker.infrastructure.vad_model",
    "schemas:generate": "node tools/schema/generate-media-analysis.mjs",
    "schemas:check": "node tools/schema/generate-media-analysis.mjs --check",
    "schemas:test": "node --test tests/integration/media-analysis.test.mjs",
    "audio:evaluate": "node tools/audio/evaluate.mjs",
    "audio:acceptance": "node tools/audio/acceptance.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1018.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "ioredis": "5.11.0",
    "lint-staged": "16.4.0",
    "pg": "8.22.0",
    "prettier": "3.9.9",
    "testcontainers": "12.2.0",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ]
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,yml,yaml}": "prettier --write",
    "*.{js,mjs,cjs,ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored --fix",
    "*.py": [
      "uv run --project workers/ai-worker ruff check --fix",
      "uv run --project workers/ai-worker ruff format"
    ]
  }
}
