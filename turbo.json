{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "UV_CACHE_DIR",
    "UV_PYTHON",
    "UV_PYTHON_INSTALL_DIR",
    "UV_TOOL_BIN_DIR",
    "UV_TOOL_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@editagent/ai-worker#build": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**", "coverage.xml", "dist-test/**"],
      "env": ["FFMPEG_PATH", "FFPROBE_PATH", "CHROME_PATH", "PLAYWRIGHT_CHROME_EXECUTABLE"],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_PUBLIC_ENDPOINT",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_REGION",
        "FFPROBE_TIMEOUT_MS",
        "PROBE_TMPDIR"
      ]
    }
  },
  "globalDependencies": ["tools/test/vitest.config.mts"]
}
