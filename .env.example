# Development placeholders for the local Compose stack.
# Copy to .env to override a value. .env is git-ignored. Do not put real credentials here.
# Compose builds container URLs from these values. Passwords must stay URL-safe.

POSTGRES_USER=editagent
POSTGRES_PASSWORD=editagent-dev-password
POSTGRES_DB=editagent
POSTGRES_PORT=5432

REDIS_PORT=6379

S3_ACCESS_KEY_ID=editagent
S3_SECRET_ACCESS_KEY=editagent-dev-secret
S3_PORT=19083
OBJECTS_PORT=19081

S3_BUCKET=editagent
S3_REGION=us-east-1

API_PORT=3001
WEB_PORT=3000

# Containers receive these derived settings. Do not point them at localhost.
# DATABASE_URL=postgresql://editagent:editagent-dev-password@postgres:5432/editagent
# REDIS_URL=redis://redis:6379/0
# S3_ENDPOINT=http://s3:8333
# S3_PUBLIC_ENDPOINT=http://localhost:19081
# API_BASE_URL=http://api:3001
#
# Host tools use the published ports: localhost:5432, localhost:6379, localhost:19083.
# Browser uploads use the object ingress at localhost:19081.
#
# Optional agent-worker provider settings. Leave unset until US-301.
# LLM_API_KEY=
# LLM_BASE_URL=http://ollama:11434
# LLM_PROVIDER=ollama
#
# GPU profile only. The default stack forces cpu and does not need NVIDIA tooling.
# EDITAGENT_AI_DEVICE=cuda
